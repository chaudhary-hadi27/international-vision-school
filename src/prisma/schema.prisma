generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          UserRole
  name          String
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  parent        Parent?
  admin         Admin?
}

enum UserRole {
  ADMIN
  PARENT
  TEACHER
}

model Admin {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Parent {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnic          String    @unique
  occupation    String?
  address       String?
  city          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  children      Student[]
}

// Student Management
model Student {
  id                String      @id @default(cuid())
  rollNumber        String      @unique
  name              String
  fatherName        String
  motherName        String?
  dateOfBirth       DateTime
  gender            Gender
  grade             String
  section           String
  admissionDate     DateTime    @default(now())
  status            StudentStatus @default(ACTIVE)
  
  address           String
  city              String
  phone             String
  whatsapp          String
  email             String?
  
  previousSchool    String?
  medicalInfo       String?
  photoUrl          String?
  
  parentId          String
  parent            Parent      @relation(fields: [parentId], references: [id])
  
  attendance        Attendance[]
  feeRecords        FeeRecord[]
  results           Result[]
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([rollNumber])
  @@index([grade, section])
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
  SUSPENDED
}

// Admission Management
model Admission {
  id                String      @id @default(cuid())
  applicationId     String      @unique
  
  studentName       String
  dateOfBirth       DateTime
  gender            Gender
  grade             String
  previousSchool    String?
  
  fatherName        String
  fatherCNIC        String
  fatherPhone       String
  fatherOccupation  String?
  
  motherName        String
  motherCNIC        String?
  motherPhone       String?
  motherOccupation  String?
  
  address           String
  city              String
  whatsappNumber    String
  email             String
  emergencyContact  String?
  emergencyRelation String?
  
  studentPhotoUrl   String?
  birthCertUrl      String?
  fatherCNICUrl     String?
  motherCNICUrl     String?
  
  status            AdmissionStatus @default(PENDING)
  reviewNotes       String?
  reviewedBy        String?
  reviewedAt        DateTime?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([applicationId])
  @@index([status])
}

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Attendance Management
model Attendance {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  date          DateTime
  status        AttendanceStatus
  remarks       String?
  markedBy      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@unique([studentId, date])
  @@index([studentId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

// Fee Management
model FeeRecord {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  
  month         String
  amount        Float
  paidAmount    Float       @default(0)
  dueDate       DateTime
  paidDate      DateTime?
  status        FeeStatus   @default(UNPAID)
  
  voucherNumber String?     @unique
  paymentMethod String?
  remarks       String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@unique([studentId, month])
  @@index([studentId, status])
}

enum FeeStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

// Results Management
model Result {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  
  examType      String
  term          String
  grade         String
  
  subjects      Json
  totalMarks    Float
  obtainedMarks Float
  percentage    Float
  gradePoint    String
  position      Int?
  
  publishedAt   DateTime?
  isPublished   Boolean     @default(false)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([studentId, term])
}

// Announcements
model Announcement {
  id            String      @id @default(cuid())
  title         String
  content       String
  type          AnnouncementType
  priority      Priority    @default(NORMAL)
  
  targetAudience String[]
  targetGrades  String[]
  
  isActive      Boolean     @default(true)
  publishDate   DateTime    @default(now())
  expiryDate    DateTime?
  
  attachmentUrl String?
  
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([isActive, publishDate])
}

enum AnnouncementType {
  GENERAL
  ACADEMIC
  EVENT
  HOLIDAY
  URGENT
  FEE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Timetable
model Timetable {
  id            String      @id @default(cuid())
  grade         String
  section       String
  dayOfWeek     Int
  
  periods       Json
  
  isActive      Boolean     @default(true)
  effectiveFrom DateTime    @default(now())
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@unique([grade, section, dayOfWeek])
}

